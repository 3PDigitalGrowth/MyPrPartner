# ── Resend (form submissions + emails) ──────────────────────────────────────
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (https://resend.com/domains).
# Until myprpartner.com is verified, leave unset to fall back to Resend's shared
# onboarding sender (delivers only to the Resend account owner's email).
RESEND_FROM="My PR Partner <hello@myprpartner.com>"

# Comma-separated internal recipients for form-submission notifications.
ADMIN_NOTIFICATION_EMAILS=info@myprpartner.com
# Comma-separated BCC recipients on admin notifications (kept off the To line).
ADMIN_NOTIFICATION_BCC=alex@3pdigital.com.au

# Absolute site URL used for links inside emails.
NEXT_PUBLIC_SITE_URL=https://myprpartner.com

# -- /admin content editor (see CMS-SETUP.md) ---------------------------------
# Shared client login password for myprpartner.com/admin. Make it long.
ADMIN_PASSWORD=
# Fine-grained GitHub PAT, Contents: Read and write on 3PDigitalGrowth/MyPrPartner
# only. Production saves commit through this token; local dev can leave it unset
# (the editor then writes straight to the working tree).
GITHUB_TOKEN=
# Optional overrides. Defaults: 3PDigitalGrowth/MyPrPartner, main.
# GITHUB_REPO=
# GITHUB_BRANCH=
# Optional: set only if sessions should survive ADMIN_PASSWORD rotation.
# ADMIN_SESSION_SECRET=
